# ==============================================================================
# SprintCare AI Support Assistant - Environment Template (.env.example)
# Copy this file to .env and configure as needed:
#   cp .env.example .env
# ==============================================================================

# Server & Networking
HOST=127.0.0.1
PORT=8000
APP_ENV=production
DEBUG=false

# Application Security Keys
SPRINTCARE_API_KEY=your_generated_api_key_here
APP_SECRET_KEY=your_secret_jwt_key_here

# Brand & Operational Constraints
DEFAULT_BRAND=@sprintcare
MAX_TWEET_LENGTH=280

# Optional: External Cloud LLM APIs (Leave blank to use default offline CPU models)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional: Live Twitter / X API Credentials (For live account webhook)
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
